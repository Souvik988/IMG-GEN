# Required: direct PostgreSQL connection string (keep it secret).
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Required: the initial administrator credentials.
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
