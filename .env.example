# development | production | test — production boot refuses to start with an
# insecure SESSION_SECRET (see below) and enforces the Secure cookie flag.
NODE_ENV=development

# ---- Core services ----
# Local ports chosen to avoid conflicts with other stacks on this machine:
# Postgres 5433, Redis 6381, Web 3100, API 4000, MinIO 9000/9001
DATABASE_URL=postgres://shotlin:shotlin@localhost:5433/shotlin
REDIS_URL=redis://localhost:6381
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=shotlin
S3_SECRET_KEY=shotlin-secret
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_OUTPUTS=outputs
S3_FORCE_PATH_STYLE=true

# ---- Auth ----
# In production this MUST be a real random secret (32+ chars) — the app
# refuses to boot with this placeholder, "dev-secret", or empty when
# NODE_ENV=production. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168

# ---- AI providers (backend only; leave empty to use mock providers) ----
OPENROUTER_API_KEY=
# Force deterministic mock adapters for all AI nodes (true/false)
MOCK_PROVIDERS=true

# ---- Cost defaults (admin-editable later; used for seeding) ----
USD_INR_RATE=95.78
