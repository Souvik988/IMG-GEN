{
  "name": "@shotlin/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@shotlin/core": "workspace:*",
    "@shotlin/database": "workspace:*",
    "@shotlin/platform": "workspace:*",
    "@shotlin/providers": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.3.0",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.15.0",
    "bullmq": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/qs": "^6.9.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
