{
  "name": "@shotlin/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@shotlin/core": "workspace:*",
    "@shotlin/database": "workspace:*",
    "@shotlin/platform": "workspace:*",
    "@shotlin/providers": "workspace:*",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.44.0",
    "ioredis": "^5.6.0",
    "pg": "^8.15.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
